CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
# CONFIG_UART_NS16550_ACCESS_WORD_ONLY=y
CONFIG_CONSOLE_HANDLER=y
CONFIG_XIP=n
CONFIG_INCLUDE_RESET_VECTOR=y
CONFIG_RISCV_S_MODE=y
CONFIG_RISCV_S_MODE_NATIVE_ENTRY=y
CONFIG_RISCV_SPMP=y
CONFIG_TOOLCHAIN_CROSS_COMPILE_SUPPORTS_THREAD_LOCAL_STORAGE=y
# APLIC delivers to S-mode external (hlic 9); the cv32a6 SoC defconfig
# assumed PLIC at M-mode external (hlic 11) which doesn't apply here.
CONFIG_2ND_LVL_INTR_00_OFFSET=9
# The cv32a6 SoC defaults CONFIG_PLIC=y; our DTS has no PLIC node so the
# PLIC driver can't compile.
CONFIG_PLIC=n
